# Dependencies and build output
node_modules/
dist/
coverage/

# Environment files: NEVER commit real settings or secrets.
# Only .env.example (names and harmless placeholders) belongs in Git.
.env
.env.*
!.env.example

# Keys and certificates must never be committed
*.pem
*.key
*.p12
*.pfx
*.vaultx-key.json

# Logs and OS/editor clutter
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Synthetic browser output
test-results/
playwright-report/
