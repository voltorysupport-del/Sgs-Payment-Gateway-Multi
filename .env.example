# VaultX Pay - example settings.
#
# HOW TO USE: copy this file to ".env" and change the placeholder values.
#   cp .env.example .env
# ".env" is git-ignored. Never put real secrets in THIS file, because it IS committed.

# --- Application ---
NODE_ENV=development
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Local PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=vaultx
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=vaultx_pay
# Change this if something else on your computer already uses port 5432
POSTGRES_PORT=5432

# Must match the values above. Used by the app from Step 2 onwards.
DATABASE_URL=postgres://vaultx:replace-with-a-local-password@localhost:5432/vaultx_pay

# --- Payment safety switches (Version 1) ---
# Real payment processing is impossible in Version 1. The app REFUSES TO START
# if LIVE_MODE_ENABLED is anything other than "false".
LIVE_MODE_ENABLED=false
# Only "simulator" is permitted in Version 1.
ALLOWED_PROVIDERS=simulator
# Test-only simulator controls. Can never be "true" when NODE_ENV=production.
SIMULATOR_CONTROLS_ENABLED=false

# Dashboard authentication remains disabled until separately approved.
DASHBOARD_ENABLED=false
# Required only if enabled: exact HTTPS origin, no trailing slash.
# DASHBOARD_PUBLIC_ORIGIN=https://your-approved-dashboard.example
# Leave empty until actual trusted ingress IPs/CIDRs are independently verified.
DASHBOARD_TRUSTED_PROXIES=

# Read-only dashboard BFF remains disabled; never put keys into frontend env vars.
DASHBOARD_BFF_ENABLED=false
# Required only after separately approved credential provisioning and enablement:
# DASHBOARD_OPERATOR_ID=YOUR_VERIFIED_OPERATOR_UUID
# DASHBOARD_READ_ONLY_API_KEY=YOUR_PRIVATE_READ_ONLY_KEY

# Separate owner management foundation: development/test only, never production.
# No owner account, enrollment ceremony or session issuer is provided.
OWNER_ENABLED=false
# OWNER_ORIGIN=https://owners.example.invalid
# Enabling for synthetic local tests also requires a different client hostname.

# Development/test merchant-management foundation (no activation authority).
MERCHANT_MANAGEMENT_ENABLED=false

# Phase 3 synthetic/local-test ceremonies only; no delivery or recovery issuer.
# Requires development/test dashboard + merchant gates. Production is refused.
PHASE3_ENROLLMENT_ENABLED=false

# Phase 4B backend authorization foundation; non-production synthetic testing only.
TERMINAL_SCOPED_READS_ENABLED=false
